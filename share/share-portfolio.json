<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>AG CRM Dashboard</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      margin: 0;
      padding: 0;
      background-color: #f4f4f4;
      display: flex;
    }
    .sidebar {
      width: 150px;
      background: #333;
      color: white;
      padding: 20px;
      height: 100vh;
      box-shadow: 2px 0 5px rgba(0, 0, 0, 0.1);
    }
    .sidebar h2, .sidebar h4 {
      text-align: center;
      margin-bottom: 20px;
    }
    .sidebar ul {
      list-style: none;
      padding: 0;
    }
    .sidebar ul li {
      margin: 10px 0;
    }
    .sidebar ul li a {
      color: white;
      text-decoration: none;
      cursor: pointer;
    }
    .content {
      flex: 1;
      padding: 20px;
    }
    .logo {
      text-align: center;
      margin-bottom: 20px;
    }
    .print-button {
      margin-top: 20px;
      display: block;
      text-align: center;
    }
    iframe {
      width: 100%;
      height: 400px;
      border: none;
    }
    table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 20px;
    }
    table,
    th,
    td {
      border: 1px solid #ddd;
    }
    th,
    td {
      padding: 8px;
      text-align: left;
    }
    th {
      background-color: #f2f2f2;
    }
    input,
    select {
      margin: 5px 0;
      padding: 5px;
      width: 100%;
      box-sizing: border-box;
    }
    button {
      padding: 8px 12px;
      margin-top: 10px;
    }
    
    h4 > span {
      color: #ff0060;
    }
  </style>
  <!-- Alpine.js Library -->
  <script src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js" defer></script>
</head>
<body x-data="{ activeFeature: 'dashboard' }">
  <!-- Sidebar Navigation -->
  <div class="sidebar">
    <div class="logo">
      <a href="https://alexgonzalez.ooo">
        <img src="./../../src/assets/AG Squares.png" alt="Logo" width="100" />
      </a>
    </div>
    <h4><span>AG</span> CRM Dashboard</h4>
    <ul>
      <li><a @click="activeFeature = 'dashboard'">Dashboard</a></li>
      <li><a @click="activeFeature = 'invoices'">Invoices</a></li>
      <li><a @click="activeFeature = 'retainers'">Retainers</a></li>
      <li><a @click="activeFeature = 'automation'">Automation</a></li>
      <li><a @click="activeFeature = 'reports'">Reports</a></li>
      <li><a @click="activeFeature = 'proposals'">Proposals</a></li>
      <li><a @click="activeFeature = 'leads'">Leads</a></li>
    </ul>
  </div>

  <!-- Main Content Area -->
  <div class="content">
    <!-- Dashboard Section -->
    <div x-show="activeFeature === 'dashboard'">
      <h3>Dashboard</h3>
      <p>Dashboard content goes here.</p>

      <!-- Dynamic Clock -->
      <div x-data="clock()" x-init="init()">
        <strong>Current Date & Time:</strong>
        <p x-text="time"></p>
      </div>

      <!-- Goals List -->
      <div x-data="goalsComponent()">
        <h4>Goals for Dashboard</h4>
        <ul>
          <template x-for="goal in goals" :key="goal.id">
            <li x-text="goal.text"></li>
          </template>
        </ul>
      </div>

      <iframe src="https://docs.google.com/spreadsheets/d/e/2PACX-1vTsHCeTyekwx4oYLsrBnWTHssZxYKlM4Ivob4CdHyz-vOknxtHMT_efu3uhJqXnOlMh7UFvqK3MXBsj/pubhtml?gid=0&single=true&widget=true&headers=false"></iframe>
    </div>

    <!-- Invoices Section -->
    <div x-show="activeFeature === 'invoices'">
      <div x-data="invoiceManager()">
        <h3>Invoices</h3>
        <hr>
        <!-- Invoice Form -->
        <form @submit.prevent="addInvoice">
          <h4>MGMT Recurring Invoices</h4>
          <label for="client-name">Client Name:</label>
          <input type="text" id="client-name" x-model="client" placeholder="Enter client name" />

          <label for="amount">Amount:</label>
          <input type="number" id="amount" x-model="amount" placeholder="Enter amount" />

          <label for="frequency">Frequency:</label>
          <select id="frequency" x-model="frequency">
            <option value="monthly">Monthly</option>
            <option value="quarterly">Quarterly</option>
            <option value="annually">Annually</option>
          </select>
          <button type="submit">Create Invoice</button>
        </form>

        <!-- Dynamic Invoices Table -->
        <table>
          <thead>
            <tr>
              <th>ID</th>
              <th>Client</th>
              <th>Amount</th>
              <th>Frequency</th>
              <th>Date Created</th>
            </tr>
          </thead>
          <tbody>
            <template x-for="invoice in invoices" :key="invoice.id">
              <tr>
                <td x-text="invoice.id"></td>
                <td x-text="invoice.client"></td>
                <td x-text="invoice.amount"></td>
                <td x-text="invoice.frequency"></td>
                <td x-text="invoice.date"></td>
              </tr>
            </template>
            <tr x-show="invoices.length === 0">
              <td colspan="5" style="text-align: center;">No invoices yet.</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Retainers Section -->
    <div x-show="activeFeature === 'retainers'">
      <h3>Retainers</h3>
      <p>Retainer management content goes here.</p>
      <iframe src="https://docs.google.com/spreadsheets/d/e/2PACX-1vTsHCeTyekwx4oYLsrBnWTHssZxYKlM4Ivob4CdHyz-vOknxtHMT_efu3uhJqXnOlMh7UFvqK3MXBsj/pubhtml?gid=1220441200&single=true&widget=true&headers=false"></iframe>
      <hr />
      <a href="https://docs.google.com/spreadsheets/d/e/2PACX-1vTsHCeTyekwx4oYLsrBnWTHssZxYKlM4Ivob4CdHyz-vOknxtHMT_efu3uhJqXnOlMh7UFvqK3MXBsj/pubhtml?gid=1220441200&single=true">View in Google Sheets</a>
    </div>

    <!-- Automation Section -->
    <div x-show="activeFeature === 'automation'">
      <h3>Automation</h3>
      <p>Automation tools and settings go here.</p>
      <p>Mind map of business processes:</p>
      <iframe src="https://www.mindmeister.com/maps/public_map_shell/1234567890?width=600&height=400&zoom=1" frameborder="0"></iframe>
    </div>

    <!-- Reports Section -->
    <div x-show="activeFeature === 'reports'">
      <h3>Reports</h3>
      <p>Reports and analytics content goes here.</p>
      <iframe src="https://docs.google.com/spreadsheets/d/e/2PACX-1vTsHCeTyekwx4oYLsrBnWTHssZxYKlM4Ivob4CdHyz-vOknxtHMT_efu3uhJqXnOlMh7UFvqK3MXBsj/pubhtml?gid=3&single=true&widget=true&headers=false"></iframe>
    </div>

    <!-- Proposals Section -->
    <div x-show="activeFeature === 'proposals'" x-data="proposalsComponent()">
      <h3>Proposals</h3>
      <p>Below is a list of blank proposals ready to be used.
         Click the links to open the proposal templates in a new tab.</p>
      <table>
        <thead>
          <tr>
            <th>Proposal Name</th>
            <th>Document Type</th>
            <th>Link</th>
          </tr>
        </thead>
        <tbody>
          <template x-for="proposal in proposals" :key="proposal.id">
            <tr>
              <td x-text="proposal.name"></td>
              <td x-text="proposal.type"></td>
              <td>
                <a :href="proposal.link" target="_blank">View Proposal</a>
              </td>
            </tr>
          </template>
        </tbody>
      </table>
    </div>

    <!-- Leads Section -->
    <div x-show="activeFeature === 'leads'" x-data="leadsComponent()">
      <h3>Leads</h3>
      <p>Add website URLs to track potential leads.</p>
      <!-- Leads Form -->
      <form @submit.prevent="addLead">
        <label for="website-name">Website Name:</label>
        <input type="text" id="website-name" x-model="newLead.name" placeholder="Enter website name" />

        <label for="website-url">Website URL:</label>
        <input type="url" id="website-url" x-model="newLead.url" placeholder="Enter website URL" />

        <button type="submit">Add Lead</button>
      </form>
      <!-- Dynamic Leads Table -->
      <table>
        <thead>
          <tr>
            <th>ID</th>
            <th>Website Name</th>
            <th>URL</th>
          </tr>
        </thead>
        <tbody>
          <template x-for="lead in leads" :key="lead.id">
            <tr>
              <td x-text="lead.id"></td>
              <td x-text="lead.name"></td>
              <td>
                <a :href="lead.url" target="_blank" x-text="lead.url"></a>
              </td>
            </tr>
          </template>
          <tr x-show="leads.length === 0">
            <td colspan="3" style="text-align: center;">No leads yet.</td>
          </tr>
        </tbody>
      </table>
    </div>

    <button class="print-button" onclick="window.print()">Print Overview</button>
  </div>

  <!-- Alpine.js Component Definitions -->
  <script>
    // Clock Component: Updates the displayed date and time every second.
    function clock() {
      return {
        time: new Date().toLocaleString(),
        init() {
          setInterval(() => {
            this.time = new Date().toLocaleString();
          }, 1000);
        }
      };
    }

    // Goals Component: Lists a few sample dashboard goals.
    function goalsComponent() {
      return {
        goals: [
          { id: 1, text: 'Increase monthly recurring revenue' },
          { id: 2, text: 'Reduce invoice processing time' },
          { id: 3, text: 'Improve client retention' }
        ]
      };
    }

    // Invoice Manager Component: Handles invoice creation and displays them in a dynamic table.
    function invoiceManager() {
      return {
        invoices: [],
        client: '',
        amount: '',
        frequency: 'monthly',
        addInvoice() {
          if (this.client && this.amount) {
            this.invoices.push({
              id: Date.now(),
              client: this.client,
              amount: parseFloat(this.amount).toFixed(2),
              frequency: this.frequency,
              date: new Date().toLocaleString()
            });
            // Reset form fields after adding an invoice.
            this.client = '';
            this.amount = '';
            this.frequency = 'monthly';
          } else {
            alert('Please fill in all required fields.');
          }
        }
      };
    }

    // Proposals Component: Lists blank proposal templates with links.
    function proposalsComponent() {
      return {
        proposals: [
          { id: 1, name: 'CPC New Haven', type: 'Google Doc', link: 'https://docs.google.com/document/d/EXAMPLE_CPC_NEW_HAVEN' },
          { id: 2, name: 'CreateCR', type: 'PDF', link: 'https://example.com/CREATECR.pdf' },
          { id: 3, name: 'Material Promotions', type: 'Google Doc', link: 'https://docs.google.com/document/d/EXAMPLE_MATERIAL_PROMOTIONS' }
        ]
      };
    }

    // Leads Component: Handles lead creation and displays a list of website URLs.
    function leadsComponent() {
      return {
        leads: [],
        newLead: {
          name: '',
          url: ''
        },
        addLead() {
          if (this.newLead.name && this.newLead.url) {
            this.leads.push({
              id: Date.now(),
              name: this.newLead.name,
              url: this.newLead.url
            });
            // Reset the input fields after adding a lead.
            this.newLead.name = '';
            this.newLead.url = '';
          } else {
            alert('Please fill in both website name and URL.');
          }
        }
      };
    }
  </script>
</body>
</html>
